# 1. Google Apps Script Web App Deployment URL
# Leave empty during local development to use interactive mock data & browser storage.
# For production, deploy your own Apps Script project and paste the Web App URL here:
# e.g. https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
VITE_API_URL=

# 2. Institution Branding Configuration (Customize for your own college/university)
VITE_COLLEGE_NAME=Your Institution / University Name
VITE_COLLEGE_SHORT_NAME=COLLEGE
VITE_PORTAL_TITLE=College QR Complaint Box
VITE_CAMPUS_PORTAL_URL=http://localhost:3000
